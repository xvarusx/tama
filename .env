
# Host port for the api-gateway (8080 is often taken; override as needed)
API_GATEWAY_PORT=8081

AUTH_DB_NAME=authentication_db
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=change_auth_password
AUTH_DB_ROOT_PASSWORD=change_auth_root_password

CLIENT_DB_NAME=client_db
CLIENT_DB_USER=client_app
CLIENT_DB_PASSWORD=change_client_password
CLIENT_DB_ROOT_PASSWORD=change_client_root_password

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_app
INVENTORY_DB_PASSWORD=change_inventory_password
INVENTORY_DB_ROOT_PASSWORD=change_inventory_root_password

AUTH_RABITMQ_USER=auth_app
AUTH_RABITMQ_PASSWORD=change_auth_password
